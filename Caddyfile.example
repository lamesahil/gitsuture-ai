# Caddyfile.example
# Replace your-domain.com with your actual public domain or IP address.
# Copy this file to /etc/caddy/Caddyfile and run `systemctl reload caddy`.

your-domain.com {
    # 1. Serve the static frontend built by Vite
    root * /opt/gitsuture/frontend/dist
    file_server
    try_files {path} /index.html

    # 2. Reverse proxy API endpoints (including webhooks at /api/webhooks/*) to the backend PM2 process
    # This preserves the /api path exactly as the Node.js Express router expects.
    reverse_proxy /api/* localhost:3001
}
