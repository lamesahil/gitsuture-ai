{
  "name": "gitsuture-backend",
  "version": "0.1.0",
  "description": "GitSuture autonomous healing backend — Phase 1 foundation",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock:webhook": "tsx scripts/trigger-mock-webhook.ts"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@google/genai": "^2.21.0",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "5.22.0",
    "cors": "^2.8.6",
    "diff": "^9.0.0",
    "dockerode": "^3.3.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.2",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "prisma": "5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
