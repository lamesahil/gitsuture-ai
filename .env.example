# GitSuture Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── GitHub Integration ────────────────────────────────────────────────────────
# The secret configured in your GitHub App / repository webhook settings.
# Used to verify x-hub-signature-256 on incoming payloads.
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Personal Access Token (classic or fine-grained) with contents:write and pr:write permissions.
GITHUB_TOKEN=your_github_token_here

# ── Agent 2 (Gemini) ──────────────────────────────────────────────────────────
# API key for Google's Gemini API (used by Agent 2 for AST repair).
# Get one here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── GitHub App (optional — PAT above is the fallback when these are absent) ────
#
# Register your GitHub App at: https://github.com/settings/apps/new
# After registration, copy the App ID from the App settings page.
# After generating a private key, set ONE of the two key options below:
#
#   Option A — path to a PEM file on disk (recommended for production):
#     GITHUB_APP_PRIVATE_KEY_PATH=/path/to/gitsuture-app.private-key.pem
#
#   Option B — raw PEM content as a single-line env var (useful for CI/CD):
#     Replace actual newlines with the literal two-character sequence \n
#     GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
#
# App ID — numeric, shown on the GitHub App settings page:
GITHUB_APP_ID=

# Path to the PEM private key file (takes priority over the inline option below):
GITHUB_APP_PRIVATE_KEY_PATH=

# Inline PEM private key content (newlines as \n) — fallback if PATH is not set:
GITHUB_APP_PRIVATE_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_URL=file:./prisma/dev.db
